{
  "name": "creaad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none \"tests/**/*.test.ts\"",
    "test:integration": "node scripts/integration.mjs",
    "test:e2e": "node scripts/e2e.mjs tests/e2e-payment.ts",
    "test:e2e:webhook": "node scripts/e2e.mjs tests/e2e-webhook.ts",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "preview": "node scripts/preview.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "collect:login": "node scripts/collector.mjs --login",
    "collect:meta": "node scripts/collector/meta_apify.mjs --max=20",
    "collect:aliexpress": "node scripts/collector/aliexpress_enrich.mjs --file=scripts/collector/products.txt",
    "costs": "node --env-file=.env.local scripts/report-costs.mjs",
    "eval:hooks": "node --env-file=.env.local scripts/eval-hooks.mjs",
    "vercel:env": "node scripts/vercel-env-add.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
