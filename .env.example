GP_BASE="https://geniuspay.ci/api/v1/merchant"
GP_PK="pk_sandbox_xxx"
GP_SK="sk_sandbox_xxx"
GP_WHSEC="whsec_xxx"

# ─── Workflow ────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Modèles & scraping (J1+) ────────────────────────────────────────────────
