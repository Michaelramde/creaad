# ─── Base ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/creaad?sslmode=require"
# Connexion directe (sans pgbouncer) — utilisée uniquement pour les migrations DDL
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/creaad?sslmode=require"
APP_URL="https://creaad.site"

# ─── Auth ────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="openssl rand -base64 32"
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Creaad <no-reply@creaad.app>"
# "true" seulement si Resend est configuré — sinon personne ne peut se connecter
REQUIRE_EMAIL_VERIFICATION="false"

# ─── Stockage (Cloudflare R2) ────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="creaad"
# OPTIONNEL : domaine public du bucket (r2.dev ou domaine perso).
# Sans lui, les images sont servies par /api/storage/… (bucket privé) —
# l'upload fonctionne quand même. Le domaine public n'est qu'une optimisation.
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ─── GeniusPay ───────────────────────────────────────────────────────────────
# À figer : geniuspay.ci ou pay.genius.ci (voir SPEC §17)
GP_BASE="https://geniuspay.ci/api/v1/merchant"
GP_PK="pk_sandbox_xxx"
GP_SK="sk_sandbox_xxx"
GP_WHSEC="whsec_xxx"

# ─── Pilotage ────────────────────────────────────────────────────────────────
# Emails autorisés sur /admin/metrics (liste séparée par des virgules).
# Vide = la page répond 404. C'est volontaire : sans admin déclaré, elle n'existe pas.
ADMIN_EMAILS="toi@exemple.com"
# "1" quand le palier Gemini devient payant : les coûts sont alors calculés,
# et non plus marqués « estimés à 0 ».
GEMINI_PAID="0"

# ─── Workflow ────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Modèles & scraping (J1+) ────────────────────────────────────────────────
GEMINI_API_KEY=""
# Google retire régulièrement d'anciens modèles : vérifier avec scripts/list-models.mjs
GEMINI_MODEL="gemini-3.5-flash"

# AliExpress Open Platform — inscription gratuite
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID="creaad"
MISTRAL_API_KEY=""
APIFY_TOKEN=""
# Acteur Apify retenu (Meta Ad Library, sans compte Facebook)
APIFY_META_ACTOR="jmlp~meta-ad-library-scraper"

# ─── Économie ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CREDIT_XOF="1000"
# Étape 2 quand le marché de ce type de produit est déjà calculé.
NEXT_PUBLIC_CREDIT_XOF_CACHED="500"
CREDIT_XOF_CACHED="500"
MIN_TOPUP_XOF="5000"
