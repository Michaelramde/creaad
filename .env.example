# ─── Base ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/creaad?sslmode=require"
# Connexion directe (sans pgbouncer) — utilisée uniquement pour les migrations DDL
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/creaad?sslmode=require"
APP_URL="https://creaad.site"

# ─── Auth ────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="openssl rand -base64 32"
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Creaad <no-reply@creaad.app>"

# ─── Stockage (Cloudflare R2) ────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="creaad"

# ─── GeniusPay ───────────────────────────────────────────────────────────────
